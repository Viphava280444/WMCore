# Pinned SSH host keys for the Tier-0 machines checked by t0-ssh-check.yml.
#
# These are PUBLIC host keys, so keeping them in the repo is safe. Pinning them
# means the job verifies it reached the real machine instead of trusting
# whatever answers on that name.
#
# Collected on 2026-07-30 from vocms047 with:
#   ssh-keyscan -t ed25519,rsa vocms0500.cern.ch vocms05012.cern.ch
#
# If a host is rebuilt its key changes and this check fails loudly. That is the
# intended behaviour: verify the new key by hand, then update this file.
vocms0500.cern.ch ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDWG9GzwVrFtaNf1fMkaeCLYzYu0amnd/gO3vF/OV/RE
vocms0500.cern.ch ssh-rsa 
vocms05012.cern.ch ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIK5jj2lOEzZP2b2QA6ZIe4Bc06D6lkmrmK40uw3wRHwe
vocms05012.cern.ch ssh-rsa 
